{
  "design_tokens": {
    "colors": {
      "rosso": "#da291c",
      "ink": "#fffffb",
      "body": "#b4b0ab",
      "muted": "#85817b",
      "canvas": "#181818",
      "elevated": "#303030",
      "deep": "#10100f",
      "light": "#fffffb",
      "soft": "#f4f1ec",
      "line": "#333331",
      "line_light": "#d9d5ce",
      "text_light": "#181818"
    },
    "font": {
